# Exclude everything except Apps Script files
**/**
!*.gs
!*.html
!appsscript.json

# Explicitly exclude problematic directories
scripts/**
tests/**
node_modules/**
.git/**
.github/**
src/**
docs/**
assets/**
monitoring/**

# Exclude config files
*.json
!appsscript.json
*.js
*.md
.eslintrc*
.prettierrc
package*.json
